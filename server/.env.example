# Copy this file to .env and fill in the values.
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string, or a local one such as mongodb://127.0.0.1:27017/crackers-shop
MONGODB_URI=mongodb://127.0.0.1:27017/crackers-shop

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Only needed if the frontend is served from a different origin during development
# (comma-separated). Leave empty when Express serves the client itself.
CLIENT_ORIGIN=

# Shop details used by the website
SHOP_NAME=Your Shop Name
SHOP_CITY=Your City
# WhatsApp number with country code, digits only (e.g. 919876543210)
WHATSAPP_NUMBER=
